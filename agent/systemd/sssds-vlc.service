[Unit]
Description=SSSDS VLC kiosk player
# Wait for the graphical login to be up before we try to draw into it.
After=graphical.target sssds-agent.service
PartOf=graphical.target

[Service]
Type=simple
User=sssds
Group=sssds
# All node-specific knobs (VIDEO_PATH, FULLSCREEN, etc.) come from here.
# The leading dash means "ok if missing" so the unit still loads on a
# half-provisioned box.
EnvironmentFile=-/etc/sssds/identity.conf
Environment=DISPLAY=:0
Environment=XAUTHORITY=/home/sssds/.Xauthority
WorkingDirectory=/opt/sssds/VLC

# Block until the X server actually accepts connections (auto-login can
# lag a few seconds behind graphical.target). Cap at 60s so a missing
# display manager doesn't pin the unit forever.
ExecStart=/bin/sh -c 'for i in $(seq 1 60); do xset -display :0 q >/dev/null 2>&1 && break; sleep 1; done; exec /opt/sssds/.venv/bin/python /opt/sssds/VLC/vlc_timestamp_tool.py'

Restart=on-failure
RestartSec=5
# Don't restart-loop forever if something is fundamentally broken.
StartLimitIntervalSec=300
StartLimitBurst=5

[Install]
WantedBy=graphical.target

[Unit]
Description=SSSDS VLC kiosk player
# Wait for the graphical login to be up before we try to draw into it.
After=graphical.target sssds-agent.service
PartOf=graphical.target

[Service]
# __NODE_USER__ is substituted by provision-node.sh.
Type=simple
User=__NODE_USER__
# All node-specific knobs (VIDEO_PATH, FULLSCREEN, etc.) come from here.
# Leading dash = "ok if missing" so the unit still loads on a half-set-up
# box. The wrapper sources this file too, so manual runs work the same.
EnvironmentFile=-/etc/sssds/identity.conf
Environment=DISPLAY=:0
WorkingDirectory=/opt/sssds/VLC

# The wrapper waits for X, discovers the right XAUTHORITY (display
# managers don't agree on where the cookie lives), then execs Python.
ExecStart=/opt/sssds/agent/start-vlc.sh

# Always restart — kiosk mode: if the player exits for any reason,
# bring it back. We disable systemd's start-rate limiter outright:
# legitimate kiosk operation (hitting Restart-video repeatedly, the
# operator stopping/starting via the dashboard, the video ending and
# looping) racks up start counts that have no business being treated
# as "this unit is broken, give up." For real failures we still rely
# on the operator noticing the screen is wrong.
Restart=always
RestartSec=2
StartLimitIntervalSec=0

# Cap how long we wait for VLC to clean up on stop. libvlc occasionally
# hangs a few seconds releasing X resources during shutdown — the
# default 90s timeout makes Restart-video feel broken. After this
# window systemd SIGKILLs.
TimeoutStopSec=3

[Install]
WantedBy=graphical.target

[Unit]
Description=SSSDS VLC kiosk player
# Wait for the graphical login to be up before we try to draw into it.
After=graphical.target sssds-agent.service
PartOf=graphical.target

[Service]
Type=simple
User=sssds
Group=sssds
# All node-specific knobs (VIDEO_PATH, FULLSCREEN, etc.) come from here.
# The leading dash means "ok if missing" so the unit still loads on a
# half-provisioned box.
EnvironmentFile=-/etc/sssds/identity.conf
Environment=DISPLAY=:0
WorkingDirectory=/opt/sssds/VLC

# The wrapper waits for X, discovers the right XAUTHORITY (display
# managers don't agree on where the cookie lives), then execs Python.
ExecStart=/opt/sssds/agent/start-vlc.sh

Restart=on-failure
RestartSec=5
StartLimitIntervalSec=300
StartLimitBurst=5

[Install]
WantedBy=graphical.target

[Unit]
Description=SSSDS museum dashboard agent
After=network-online.target
Wants=network-online.target

[Service]
# __NODE_USER__ / __NODE_HOME__ are substituted by provision-node.sh.
Type=simple
User=__NODE_USER__
ExecStart=/opt/sssds/.venv/bin/python -m agent.main
WorkingDirectory=/opt/sssds
Restart=always
RestartSec=3

# Soft hardening — agent needs sudo for a few commands so we can't lock
# this down further without breaking the control path.
NoNewPrivileges=false
ProtectSystem=strict
ReadWritePaths=/var/lib/sssds /var/log/sssds

[Install]
WantedBy=multi-user.target

[Unit]
Description=Persist ethtool Wake-on-LAN flag on the primary interface
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
# Resolve the default-route interface and enable magic-packet wake.
# This re-runs every boot because some NICs reset the flag.
ExecStart=/bin/sh -c 'IF=$(ip route show default | awk "{for(i=1;i<=NF;i++) if(\\$i==\\"dev\\") print \\$(i+1); exit}"); [ -n "$IF" ] && /sbin/ethtool -s "$IF" wol g'

[Install]
WantedBy=multi-user.target
